# Copy this file to `.env.local` and fill in the real values. DO NOT commit `.env.local` to git.
#
# IMPORTANT:
# - You exposed a client secret earlier; rotate that secret in Google Cloud Console immediately
#   and replace the value below with the new secret.
# - Use the NEXT_PUBLIC_ prefix only for values that are safe to expose to client-side code.

# Public (client) ID used by the client-side Google script
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Server-side client ID (can be same as above). Used when verifying tokens server-side.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Server-side client secret (sensitive) — store only on server / Vercel environment settings.
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# URL of your site (used by auth libraries). Change to your production URL.
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign session cookies / tokens. Generate a secure random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_generated_random_hex_64_chars


